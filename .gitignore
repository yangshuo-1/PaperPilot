# ---- Python ----
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
develop-eggs/
dist/
*.log

# ---- LLM secrets ----
# Self-contained LLM config holds the api_key; only the example is committed.
# M0 后主载体是设置页写入 <data_dir>/db.sqlite；本文件是开发/迁移期来源。
llm_config.json

# ---- Local dev data root (PAPERPOILOT_DATA_DIR 指向仓库内时使用) ----
.data/

# ---- Local Codex agents ----
.codex

# ---- Node / Vite ----
frontend/node_modules/
frontend/dist/
# 预构建前端随 wheel 发布，由 `npm run build` 生成（vite outDir），禁止手改/入库
src/paperpilot/web/
*.tsbuildinfo

# ---- 数据根（仓库外） ----
# 数据根由 PAPERPOILOT_DATA_DIR 指定（默认 ~/.local/share/paperpilot），仓库只放代码：
# 用户数据、运行态 db.sqlite、任务产物都不在仓库内（见 docs/design/data-organization.md）。
# 下面三条只是保险：若开发时把数据根指到仓库根（如 PAPERPOILOT_DATA_DIR=$PWD），也不会误入库。
papers/
references/
projects/

# SQLite 运行态库（含 WAL/SHM 伴生文件），仅在数据根被指到仓库内时出现
db.sqlite*
paper_valt.db*

# ---- OS / editor ----
.DS_Store
.idea/
.vscode/
*.swp
