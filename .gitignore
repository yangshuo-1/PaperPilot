# ---- Python ----
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
develop-eggs/
dist/
*.log

# ---- LLM secrets ----
# Self-contained LLM config holds the api_key; only the example is committed.
# M0 后主载体是设置页写入 <data_dir>/db.sqlite；本文件是开发/迁移期来源。
llm_config.json

# ---- Local dev data root (PAPERPOILOT_DATA_DIR 指向仓库内时使用) ----
.data/

# ---- Local Codex agents ----
.codex

# ---- Node / Vite ----
frontend/node_modules/
frontend/dist/
# 预构建前端随 wheel 发布，由 `npm run build` 生成（vite outDir），禁止手改/入库
src/paperpilot/web/
*.tsbuildinfo

# ---- Data assets ----
# 决策表见 docs/design/data-organization.md：分析成果/图源/审计入 git，大二进制/可复现/成本产物不入。
# 迁移期新旧布局并存：旧平铺按文件忽略，新四层按目录忽略。

# 大二进制与可重拉（新旧布局通用）
papers/**/*.pdf
papers/**/latex/

# 旧平铺布局的可复现/成本产物（过渡，随四层迁移逐步消失）
papers/**/latex_parsed.json
papers/**/latex_plain.txt
papers/**/latex_source.md
papers/**/reader_manifest.json
papers/**/translation_zh.json
papers/**/ai_answers.jsonl
papers/**/ai_takeaways.json

# 新四层布局：source 不可变重数据、derived 可复现、exports 用户临时导出
papers/*/source/
papers/*/derived/
papers/*/exports/
# 新四层布局的 LLM 成本产物
papers/*/results/translation_zh.json
papers/*/results/ai_answers.jsonl
papers/*/results/ai_takeaways.json

# SQLite 运行态库（含 WAL/SHM 伴生文件）
references/paper_valt.db*

# ---- Runtime job artifacts ----
references/codex_jobs/
references/translation_jobs/
references/takeaway_jobs/
references/diagram_jobs/
projects/
references/paper_discovery.json
references/paper_discovery_history.json
references/paper_discovery_review.json
references/paper_discovery_review.md

# ---- OS / editor ----
.DS_Store
.idea/
.vscode/
*.swp
