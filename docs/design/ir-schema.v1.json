{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paper-valt.local/schemas/ir-schema.v1.json",
  "title": "paper_valt diagram intermediate representation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "type",
    "title",
    "nodes",
    "edges"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "type": {
      "enum": [
        "workflow",
        "data_flow"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "nodes": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/group"
      }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "section",
        "page",
        "quote"
      ],
      "properties": {
        "section": {
          "type": "string",
          "minLength": 1
        },
        "page": {
          "type": "integer",
          "minimum": 0
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "role",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "input",
            "module",
            "loss",
            "data",
            "model",
            "output",
            "eval"
          ]
        },
        "detail": {
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "label",
        "evidence"
      ],
      "properties": {
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "nodes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
